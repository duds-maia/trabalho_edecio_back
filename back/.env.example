# Supabase > Connect: copie as URLs do seu projeto e substitua os exemplos.
# Backend em produção/serverless: Transaction pooler (porta 6543). Nunca use no frontend.
DATABASE_URL="postgresql://postgres.PROJECT_REF:SENHA@HOST_DO_POOLER:6543/postgres?pgbouncer=true&connection_limit=1"
# Prisma CLI/migrações: Session pooler (porta 5432), ou Direct connection se houver IPv6.
DIRECT_URL="postgresql://postgres.PROJECT_REF:SENHA@HOST_DO_POOLER:5432/postgres"

# Autenticação
JWT_SECRET=
ADMIN_NAME=Administrador
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Frontends autorizados, separados por virgula
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://teste-de-front-rose.vercel.app

# Ative quando o backend estiver atras de um proxy reverso confiavel
TRUST_PROXY=false

# Integração opcional: Gemini (resumo de avaliações)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
