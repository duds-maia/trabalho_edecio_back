# PostgreSQL/Neon
DATABASE_URL=
# URL direta (sem "-pooler") usada apenas pelo Prisma CLI/migrations
DIRECT_URL=

# Autenticação
JWT_SECRET=
ADMIN_NAME=Administrador
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Frontends autorizados, separados por virgula
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Ative quando o backend estiver atras de um proxy reverso confiavel
TRUST_PROXY=false

# Integração opcional: Gemini (resumo de avaliações)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
